@@ -0,0 +1,108 @@
+#!/usr/bin/env python3
+"""Exact fresh-process comparison; exclusions were set before production edits."""
+import difflib
+import argparse
+import hashlib
+import json
+from pathlib import Path
+import re
+import subprocess
+import sys
+
+TASK = Path(__file__).resolve().parents[1]
+RUN = Path('/tmp/20261011_04_f11-fixed-source-core-refactor')
+parser = argparse.ArgumentParser()
+parser.add_argument('--label', default='comparison')
+a = parser.parse_args()
+DEST = TASK / 'logs' / a.label
+DEST.mkdir(exist_ok=False)
+results = {}
+
+def canonical_text(text):
+    lines = []
+    for line in text.splitlines():
+        if line.startswith('Build time  :'):
+            line = 'Build time  : <time>'
+        elif line.startswith('Input File = '):
+            line = re.sub(r'\d{4}/\d\d/\d\d .*', '<date>', line)
+        elif line.startswith('Total Calculational Time:'):
+            line = 'Total Calculational Time: <time>'
+        elif re.match(r'^\s*(?:Total Calculation Time|Time in |Time spent |Calculation rate in )', line):
+            line = re.sub(r'[-+]?\d+(?:\.\d*)?(?:[eE][-+]?\d+)?', '<time>', line)
+        lines.append(line)
+    return '\n'.join(lines)
+
+def hdf(path):
+    raw = subprocess.check_output(['h5dump', '-m', '%.17g', '-y', '-w', '0', str(path)], text=True)
+    if path.parent.name == 'fixed_source_4' and path.name == 'inp.Result.h5':
+        # The pre-run plan explicitly permits wall-clock-dependent FOM values.
+        # Preserve dataset existence, type and shape; normalize only six DATA bodies.
+        names = subprocess.check_output(['h5dump', '-n', str(path)], text=True)
+        paths = {line.strip().removeprefix('dataset').strip() for line in names.splitlines()
+                 if 'dataset' in line and line.strip().endswith(('/FOM', '/Fluctuated_FOM', '/Batches_of_FOM'))}
+        expected = {f'/Tally/CellTally2/Cell{cell}/TotalBin/{name}' for cell in [1,3]
+                    for name in ['FOM', 'Fluctuated_FOM', 'Batches_of_FOM']}
+        assert paths == expected
+        pattern = r'(DATASET "(?:FOM|Fluctuated_FOM|Batches_of_FOM)" \{\s*DATATYPE[^\n]*\n\s*DATASPACE[^\n]*\n\s*DATA \{)\n.*?\n(\s*\}\n\s*\})'
+        raw, n = re.subn(pattern, r'\1\n <wall-clock-dependent-FOM>\n\2', raw, flags=re.S)
+        assert n == 6
+    return re.sub(r'^HDF5 "[^"]*"', 'HDF5 "<file>"', raw)
+
+def same(label, old, new):
+    ok = old == new
+    results[label] = ok
+    if not ok:
+        (DEST / (re.sub(r'[^a-zA-Z0-9_-]', '_', label) + '.diff')).write_text(
+            ''.join(difflib.unified_diff(old.splitlines(True), new.splitlines(True),
+                                        fromfile='baseline', tofile='refactor')))
+    return ok
+
+def directories(label, old, new):
+    assert (old / 'inp').read_bytes() == (new / 'inp').read_bytes()
+    for name in ['inp.Tally', 'test_result', 'inp.material']:
+        if (old / name).exists():
+            same(label + '/' + name, (old / name).read_text(), (new / name).read_text())
+    same(label + '/inp.out', canonical_text((old / 'inp.out').read_text()),
+         canonical_text((new / 'inp.out').read_text()))
+    old_files = sorted(f.name for f in old.glob('*.h5') if not f.name.startswith('reference'))
+    new_files = sorted(f.name for f in new.glob('*.h5') if not f.name.startswith('reference'))
+    same(label + '/hdf-files', repr(old_files), repr(new_files))
+    for name in old_files:
+        same(label + '/' + name, hdf(old / name), hdf(new / name))
+
+for case, path in json.loads((TASK / 'logs/baseline-case-paths.json').read_text()).items():
+    directories(case, Path(path), RUN / 'refactor-runs' / case)
+
+ctests = ['fixed_source_1', 'fixed_source_4', 'fixed_source_adjoint', 'var_reduce_wwmesh_n',
+          'fixed_source_photon', 'fixed_source_electron', 'fixed_source_photon_and_electron',
+          'fixed_source_neutron_and_photon_and_electron', 'RestartFixRead']
+for case in ctests:
+    directories('ctest-' + case, RUN / 'baseline-existing-runs' / case,
+                RUN / 'refactor-existing-runs' / case)
+
+old_index = json.loads((TASK / 'logs/baseline-diagnostics-index.json').read_text())
+new_index = json.loads((TASK / 'logs/refactor-diagnostics-index.json').read_text())
+for case in old_index:
+    old = json.loads((TASK / old_index[case] / 'result.json').read_text())
+    new = json.loads((TASK / new_index[case] / 'result.json').read_text())
+    same('diagnostic-' + case, json.dumps(old, sort_keys=True), json.dumps(new, sort_keys=True))
+
+def flags(path):
+    data = path.read_text()
+    defines = re.search(r'^CXX_DEFINES = (.*)$', data, re.M).group(1)
+    options = re.search(r'^CXX_FLAGS = (.*)$', data, re.M).group(1)
+    return defines, options
+
+for suffix in ['build', 'mpi-build']:
+    same('flags-' + suffix, repr(flags(RUN / ('baseline-' + suffix) / 'CMakeFiles/RMC.dir/flags.make')),
+         repr(flags(RUN / ('refactor-' + suffix) / 'CMakeFiles/RMC.dir/flags.make')))
+
+summary = {'checks': len(results), 'passed': sum(results.values()), 'failed': [k for k,v in results.items() if not v],
+           'all_passed': all(results.values()), 'results': results,
+           'physical_tolerance': 0, 'text_tally_comparison': 'byte-equivalent text',
+           'HDF5_comparison': 'all datasets at 17 significant digits; six documented wall-clock FOM DATA bodies normalized; all datatype/dataspace metadata retained',
+           'diagnostic_comparison': 'all events digest + raw IEEE vector bits + counts/source ownership'}
+(DEST / 'results.json').write_text(json.dumps(summary, indent=2))
+print('Exact comparison:', summary['passed'], '/', summary['checks'])
+print('Failed:', summary['failed'])
+sys.exit(0 if summary['all_passed'] else 1)
diff --git a/MLVR_develop/2026-10/20261011_04_f11-fixed-source-core-refactor/tools/diagnose.gdb b/MLVR_develop/2026-10/20261011_04_f11-fixed-source-core-refactor/tools/diagnose.gdb
new file mode 100644
index 0000000..b69e0d4
--- /dev/null
+++ b/MLVR_develop/2026-10/20261011_04_f11-fixed-source-core-refactor/tools/diagnose.gdb
@@ -0,0 +1,169 @@
+set pagination off
+set confirm off
+set print pretty off
+python
+import gdb, json, hashlib, struct
+counts = {}
+errors = []
+digest = hashlib.sha256()
+result = {}
+inferior = gdb.selected_inferior
+
+def emit(kind, data):
+    counts[kind] = counts.get(kind, 0) + 1
+    row = json.dumps([kind, data], sort_keys=True, separators=(',', ':'))
+    digest.update((row + '\n').encode())
+    print('TRACEJSON ' + row)
+
+def obj(v):
+    while v.type.code == gdb.TYPE_CODE_REF:
+        v = v.referenced_value()
+    if v.type.code == gdb.TYPE_CODE_PTR:
+        v = v.dereference()
+    return v
+
+def val(name):
+    return gdb.parse_and_eval(name)
+
+def bits(v):
+    return struct.pack('<d', float(v)).hex()
+
+def vector(v):
+    b, e = v['_M_impl']['_M_start'], v['_M_impl']['_M_finish']
+    n = int(e-b)
+    raw = bytes(inferior().read_memory(b, n*b.type.target().sizeof)) if n else b''
+    return {'n': n, 'bits': raw.hex()}
+
+def particle(v):
+    v = obj(v)
+    return {'pos': [bits(v['p_dPos'][i]) for i in range(3)],
+            'dir': [bits(v['p_dDir'][i]) for i in range(3)],
+            'w': bits(v['p_dWgt']), 'energy': bits(v['p_dErg']),
+            'type': int(v['p_eParticleType']), 'adj': bool(v['p_bIsAdjointParticle']),
+            'killed': bool(v['p_bIsKilled'])}
+
+def rng(v):
+    v = obj(v)
+    gen = v['generator']['_M_ptr'].dereference()
+    return dict(type=int(v['type']), **{k: int(gen[k]) for k in
+                ['RN_SEED0', 'RN_SEED', 'RN_STRIDE', 'RN_POSITION', 'RN_POSITION_PRE']})
+
+def source(v):
+    v = obj(v)
+    return {'fraction': vector(v['p_vFraction']), 'bias': vector(v['p_vBiasFrac']),
+            'initial_n': int(v['p_nFixedInitSrcBankCount']),
+            'initial_p': int(v['p_nFixedInitPhoSrcBankCount'])}
+
+def fixed(v):
+    v = obj(v)
+    return {k: int(v[k]) for k in ['p_llCurTotParNum', 'p_llCurParNumEachPro',
+                                 'p_llCurrentBatch', 'p_nFinishCalculate', 'p_nFixedSrcCount']} | \
+           {'denominator_bits': bits(v['p_dTotStartWgt'])}
+
+def tally(v, fields):
+    v = obj(v)
+    out = {}
+    for name in ['p_OCellTallyData', 'p_OMeshTallyData']:
+        d = v[name]
+        out[name] = {k: vector(d[k]) for k in fields}
+    registry = v['p_pTallyDataPointer']
+    b, e = registry['_M_impl']['_M_start'], registry['_M_impl']['_M_finish']
+    n = int(e-b)
+    addresses = {int(v[name].address) for name in ['p_OCellTallyData', 'p_OMeshTallyData']}
+    out['registry'] = {'n': n, 'owned': [int(b[i]) in addresses for i in range(n)]}
+    return out
+
+class Finish(gdb.FinishBreakpoint):
+    def __init__(self, callback):
+        super().__init__(gdb.newest_frame(), internal=True)
+        self.callback = callback
+    def stop(self):
+        try:
+            self.callback()
+            return False
+        except Exception as ex:
+            errors.append(str(ex)); print('PROBE_ERROR '+str(ex)); return True
+
+class Probe(gdb.Breakpoint):
+    def __init__(self, spec, callback):
+        super().__init__(spec, internal=True)
+        self.callback = callback
+    def stop(self):
+        try:
+            self.callback()
+            return False
+        except Exception as ex:
+            errors.append(str(ex)); print('PROBE_ERROR '+str(ex)); return True
+
+original_source_ptr = None
+def run_enter():
+    global original_source_ptr
+    original_source_ptr = obj(val('cExternalSource')).address
+    before = source(original_source_ptr.dereference())
+    emit('RUN_SOURCE_BEFORE', before)
+    def done():
+        after = source(original_source_ptr.dereference())
+        result['external_source_unchanged'] = before == after
+        emit('RUN_SOURCE_AFTER', after)
+    Finish(done)
+
+def wrapper_enter():
+    result['source_work_is_copy'] = int(obj(val('cExternalSource')).address) != int(original_source_ptr)
+    emit('WRAPPER_COPY', result['source_work_is_copy'])
+
+def sample():
+    emit('RNG_BEFORE_SAMPLE', rng(val('ORNG')))
+    ptr = obj(val('cParticleState')).address
+    Finish(lambda: emit('SOURCE', particle(ptr.dereference())))
+
+def track():
+    emit('TRACK', particle(val('cParticleState')))
+
+def segment():
+    emit('SEGMENT', particle(val('cParticleState')) | {'length': bits(val('dTrackLen'))})
+
+def history():
+    emit('HISTORY_SCORE', tally(val('this'), ['p_vScore']))
+
+def ww():
+    state = obj(val('cParticleState'))
+    w, lo, hi = float(state['p_dWgt']), float(val('dLowWeightBound')), float(val('dUpperWeightBound'))
+    if lo and (w < lo or w > hi):
+        kind = 'ROULETTE' if w < lo else 'SPLIT'
+        emit(kind, particle(state) | {'lo': bits(val('dLowWeightBound')), 'hi': bits(val('dUpperWeightBound'))})
+
+def bank():
+    emit('BANK_SAMPLE', {'rng': rng(val('ORNG')), 'type': int(val('particleType'))})
+
+def process():
+    emit('PROCESS_ENTRY', fixed(val('cFixedSource')))
+    ptr = val('this')
+    emit('STAT_BEFORE', tally(ptr, ['p_vScore', 'p_vScoreTemp', 'p_vSum1', 'p_vSum2']))
+    def done():
+        stats = tally(ptr, ['p_vScore', 'p_vScoreTemp', 'p_vSum1', 'p_vSum2', 'p_vAve', 'p_vRe'])
+        result['final_stats'] = stats
+        emit('STAT_AFTER', stats)
+    Finish(done)
+
+Probe('CDCalMode::RunCalculation', run_enter)
+Probe('CDCalMode::CalcFixedSource', wrapper_enter)
+Probe('CDFixedSource::InitiateAll', lambda: emit('INIT', 1))
+Probe('CDFixedSource::SampleFixSource', sample)
+Probe('CDFixedSource::TrackHistory', track)
+Probe('CDTally::TallyByTL', segment)
+Probe('CDTally::SumUpTally(long long, double)', history)
+Probe('CDWeightWindow::DoWeightWindows', ww)
+Probe('CDFixedSource::SampleFromParticleBank', bank)
+Probe('CDTally::ProcessTally(CDFixedSource&, CDMaterial&, CDAceData&)', process)
+Probe('CDFixedSource::PrcoessBatchEnd', lambda: emit('BATCH_END', fixed(val('this'))))
+end
+run
+python
+result['counts'] = counts
+result['trace_sha256'] = digest.hexdigest()
+result['errors'] = errors
+print('DIAGNOSTIC_RESULT ' + json.dumps(result, sort_keys=True))
+if errors:
+    gdb.execute('quit 2')
+end
+quit
