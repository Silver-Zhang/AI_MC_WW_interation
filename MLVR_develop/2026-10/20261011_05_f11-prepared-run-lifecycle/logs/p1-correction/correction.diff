 std::map<std::string,std::string> options;
 std::string option(const std::string &name, const std::string &fallback = "") {
   auto it = options.find(name); return it == options.end() ? fallback : it->second;
+}
+void setTestWWParameters() {
+  for (const auto &entry : std::vector<std::pair<std::string, int>>{
+         {"--ww-upper", CDWeightWindow::WUPN}, {"--ww-survival", CDWeightWindow::WSURVN},
+         {"--ww-split", CDWeightWindow::MXSPLN}})
+    if (!option(entry.first).empty()) OWeightWindow.p_vWeightWindowPara.at(1).at(entry.second) = std::stod(option(entry.first));
+}
+void mutateTestUniverse(CDGeometry &geometry, const std::string &kind) {
+  const auto count = geometry.p_vUniverse.size();
+  if (kind == "universe-origin" || kind == "universe-rotation" || kind == "universe-membership") {
+    auto &u = geometry.p_vUniverse.at(geometry.p_OUniverseIndex.GetIndex(2));
+    if (!u.p_bIsMoved || !u.p_bIsRotated || u.p_vFillCellsIndex.empty()) throw std::runtime_error("Universe fixture lacks active transforms/membership");
+    if (kind == "universe-origin") u.p_dOrigin[0] += .25;
+    if (kind == "universe-rotation") u.p_dRotation[0][0] = -u.p_dRotation[0][0];
+    if (kind == "universe-membership") u.p_vFillCellsIndex[0] = geometry.p_OCellIndex.GetIndex(22);
+  } else if (kind == "universe-fill") {
+    auto &u = geometry.p_vUniverse.at(geometry.p_OUniverseIndex.GetIndex(1));
+    if (!u.p_bIsLattice || u.p_vFillLatUnivIndex.size() < 2) throw std::runtime_error("Universe fixture lacks lattice fill");
+    u.p_vFillLatUnivIndex[0] = geometry.p_OUniverseIndex.GetIndex(3);
+  } else if (kind == "universe-random") geometry.p_vUniverse.at(0).p_bIsrandom = true;
+  else throw std::runtime_error("unknown Universe mutation");
+  if (geometry.p_vUniverse.size() != count) throw std::runtime_error("Universe mutation changed size");
+  std::cout << "UNIVERSE_MUTATION " << kind << " size=" << count << '\n';
 }
