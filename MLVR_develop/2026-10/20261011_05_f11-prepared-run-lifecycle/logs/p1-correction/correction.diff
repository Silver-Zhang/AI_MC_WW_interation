+void universeDefinition(std::ostream &out, const CDUniverse &u) {
+  // Stable model data, including the precomputed adjacency used by transport.
+  // Per-particle location and stochastic-media caches are not model definitions.
+  out << "/universe/" << u.p_nContainCellNum << '/' << u.p_bIsMoved << '/' << u.p_bIsRotated
+      << '/' << u.p_bIsLattice << '/' << u.p_nLatType << '/';
+  values(out, u.p_vFillCellsIndexU); values(out, u.p_vFillCellsIndex);
+  out << '/' << u.p_vNeighborCells.size() << ':';
+  for (const auto &neighbors : u.p_vNeighborCells) values(out, neighbors);
+  for (int i = 0; i < 3; ++i) {
+    out << '/' << u.p_dOrigin[i] << '/' << u.p_dPitch[i] << '/' << u.p_nScope[i];
+    for (int j = 0; j < 3; ++j) out << '/' << u.p_dRotation[i][j];
+  }
+  out << '/' << u.p_dSita << '/' << u.p_dSin_sita << '/' << u.p_dCos_sita
+      << '/' << u.p_dHeight << '/' << u.p_nFilledLatNum << '/';
+  values(out, u.p_vFillLatUnivIndexU); values(out, u.p_vFillLatUnivIndex);
+}
+void checkNativeParameters() {
+  requirePrepared(OWeightWindow.p_vWeightWindowPara.size() > 1 &&
+                  OWeightWindow.p_vWeightWindowPara[1].size() >= 8, "WW parameters missing");
+  const auto &p = OWeightWindow.p_vWeightWindowPara[1];
+  const double upper = p[CDWeightWindow::WUPN], survival = p[CDWeightWindow::WSURVN], split = p[CDWeightWindow::MXSPLN];
+  // Native user manual: WUPN > 2, 1 < WSURVN < WUPN, MXSPLN > 1.
+  // The storage type is double, but native splitting assigns MXSPLN to an int.
+  requirePrepared(std::isfinite(upper) && upper > 2., "WW WUPN must be finite and > 2");
+  requirePrepared(std::isfinite(survival) && survival > 1. && survival < upper,
+                  "WW WSURVN must be finite and 1 < WSURVN < WUPN");
+  requirePrepared(std::isfinite(split) && split > 1. && split <= INT_MAX && std::floor(split) == split,
+                  "WW MXSPLN must be a finite integer in [2, INT_MAX]");
 }
