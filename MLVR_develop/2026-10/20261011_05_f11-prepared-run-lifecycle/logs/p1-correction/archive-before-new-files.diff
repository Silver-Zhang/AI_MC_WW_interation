+/// Restricted persistent fixed-source contract. No model ownership.
+#ifndef RMC_FIXED_SOURCE_RUN_SPEC_H
+#define RMC_FIXED_SOURCE_RUN_SPEC_H
+#include <cstdint>
+#include <string>
+#include <vector>
+enum class FixedSourceRole { Forward, Adjoint };
+struct FixedSourceSeriesSpec {
+  std::uint64_t rootSeed = 17, stride = 100000, firstHistoryOffset = 0;
+};
+struct FixedSourceWeightWindowSpec {
+  bool enabled = false;
+  FixedSourceRole appliesToTransportRole = FixedSourceRole::Forward;
+  std::string identity;
+  std::vector<double> lower;
+};
+struct FixedSourceRunSpec {
+  std::uint64_t runId = 0;
+  FixedSourceRole role = FixedSourceRole::Forward;
+  long long sourceHistories = 0;
+  double maxAdjointEnergyMeV = 30.;
+  std::string sourceIdentity;
+  FixedSourceWeightWindowSpec weightWindow;
+};
+struct FixedSourceWeightAudit {
+  long long sampledHistories = 0, nonUnitHistories = 0;
+  double initialWeightSum = 0., minimumInitialWeight = 0., maximumInitialWeight = 0.;
+};
+struct FixedSourceRunReceipt {
+  std::uint64_t runId = 0;
+  FixedSourceRole role = FixedSourceRole::Forward;
+  long long requestedHistories = 0, completedHistories = 0;
+  double normalizationDenominator = 0.;
+  FixedSourceWeightAudit sourceWeightAudit;
+  bool unitSourceWeightsVerified = false;
+  double prepareSeconds = 0., transportSeconds = 0., tallyFinalizeSeconds = 0., mcSeconds = 0.;
+  double measuredMcSeconds = 0.; // independent t3-t0 rounding check
+  std::string timingScope = "prepare+transport+finalize";
+  std::string statisticsTimingScope = "legacy_mixed_not_per_run";
+  bool statisticsFomIsRunMetric = false;
+  std::uint64_t rootSeed = 0, effectiveSeed = 0, stride = 0, historyOffset = 0, finalSeed = 0;
+  std::uint64_t maximumHistoryDraws = 0;
+  long long finalPosition = 0, finalPositionPre = 0, batches = 0, collisions = 0, missedParticles = 0;
+  std::string sourceIdentity, weightWindowIdentity;
+};
+#endif
diff --git a/src/PrepareFixedSourceRun.cpp b/src/PrepareFixedSourceRun.cpp
new file mode 100644
index 0000000..7b76fdd
--- /dev/null
+++ b/src/PrepareFixedSourceRun.cpp
@@ -0,0 +1,308 @@
+/// Restricted persistent fixed-source lifecycle. Transport remains in the Stage 1 core.
+#include "CalMode.h"
+#include "Utility/Timer.h"
+#include <chrono>
+#include <cmath>
+#include <climits>
+#include <stdexcept>
+#include <sstream>
+#include <iomanip>
+#ifdef __linux__
+#include <fcntl.h>
+#include <unistd.h>
+#endif
+
+namespace {
+bool validPreparedFile(FILE *file) {
+#ifdef __linux__
+  return file && fcntl(fileno(file), F_GETFD) != -1;
+#else
+  return false;
+#endif
+}
+std::vector<const void *> outputHandles() {
+  return {Output.p_fpOutputFilePtr, Output.p_fpTallyFilePtr, Output.p_fpMatFilePtr,
+          Output.p_Result, Output.p_Infomation, Output.p_State};
+}
+const CDCalMode *preparedProcessOwner = nullptr; // terminal reservation, including Closed/Failed
+void requirePrepared(bool ok, const char *message) {
+  if (!ok) throw std::invalid_argument(std::string("prepared: ") + message);
+}
+template<class T> void values(std::ostream &out, const std::vector<T> &v) {
+  out << v.size() << ':';
+  for (const auto &x : v) out << x << ',';
+}
+template<class T> void values(std::ostream &out, const std::vector<std::vector<T>> &v) {
+  out << v.size() << ':';
+  for (const auto &x : v) values(out, x);
+}
+void meshDefinition(std::ostream &out, const CDMesh &m) {
+  out << m.p_nGeoType << m.p_bIsHeterMesh << m.p_bUseVol << m.p_nTotMeshNum;
+  for (int i = 0; i < 3; ++i)
+    out << '/' << m.p_nMeshScope[i] << '/' << m.p_nMeshNum[i] << '/' << m.p_dBoundMin[i]
+        << '/' << m.p_dBoundMax[i] << '/' << m.p_dMeshDelt[i];
+  values(out, m.p_vMeshNum); values(out, m.p_vMeshBound);
+}
+std::string definition(CDAceData &ace, CDMaterial &material, CDGeometry &geometry, CDTally &tally) {
+  std::ostringstream out; out << std::hexfloat;
+  out << ace.p_nNeuMltGrpNum << '/' << ace.p_nPhoMltGrpNum << '/' << ace.p_vNuclides.size();
+  values(out, ace.p_vNeuMltErgBins); values(out, ace.p_vPhoMltErgBins);
+  // Identity plus all raw arrays; role-derived arrays deliberately excluded.
+  for (size_t i = 1; i < ace.p_vNuclides.size(); ++i) {
+    const auto &n = ace.p_vNuclides[i];
+    out << &n << '/' << n.XSS.data() << '/' << n.PXSS.data();
+    values(out, n.XSS); values(out, n.PXSS); values(out, n.NXS); values(out, n.JXS); values(out, n.PNXS); values(out, n.PJXS);
+  }
+  out << geometry.p_vCell.size() << '/' << geometry.p_vUniverse.size() << '/' << geometry.p_vSurface.size();
+  for (const auto &mat : material.p_vMatSet) {
+    values(out, mat.p_vMatNucIndex); values(out, mat.p_vMatNucAtomDen);
+    out << mat.p_dMatAtomDen << '/' << mat.p_dMatGramDen;
+  }
+  for (size_t i = 1; i < geometry.p_vCell.size(); ++i) {
+    const auto &c = geometry.p_vCell[i];
+    out << c.p_nFillUnivIndex << '/' << c.p_nMatIndex << '/' << c.p_dNeuImp << '/' << c.p_dTemp << '/' << c.p_dDensRatio;
+    values(out, c.p_vBoundSurf); values(out, c.p_vBooleanSurfaces);
+    for (int j = 0; j < 3; ++j) {
+      out << c.p_dMove[j] << '/' << c.p_dFillMove[j];
+      for (int k = 0; k < 3; ++k) out << c.p_dRotation[j][k] << '/' << c.p_dFillRotation[j][k];
+    }
+  }
+  for (size_t i = 1; i < geometry.p_vSurface.size(); ++i) {
+    const auto &s = geometry.p_vSurface[i];
+    out << s.p_nType << '/' << s.p_nBoundCond << '/' << s.p_nPairSurf;
+    values(out, s.p_vParas);
+  }
+  auto base = [&](const BaseTally &t) {
+    out << t.p_nTallyID << '/' << t.tallyType->type << '/' << int(t.estimator) << '/' << t.p_nTallyParticle
+        << '/' << t.p_nDataStartPtr << '/' << t.p_nDataLen << '/' << t.p_bUseStatisticalCheck;
+  };
+  for (const auto &t : tally.p_vCellTally) { base(t); values(out, t.p_vErgBins); values(out, t.p_vCellVecListU); }
+  for (const auto &t : tally.p_vMeshTally) { base(t); values(out, t.p_vErgBins); meshDefinition(out, t.p_OTallyMesh); }
+  for (const auto *d : tally.p_pTallyDataPointer) {
+    out << d << '/' << d->p_vScore.size() << '/' << d->p_vSum1.size() << '/' << d->p_vSum3.size();
+    const auto &s = d->p_OStatisticsTester;
+    out << s.p_nBatch << '/' << s.p_nTallyToCheck << '/' << s.p_npdfBin;
+    values(out, s.p_vIndexOfTallyData);
+  }
+  meshDefinition(out, OWeightWindow.p_OWeightWindowMesh);
+  values(out, OWeightWindow.p_vEnergyBins); values(out, OWeightWindow.p_vWeightWindowPara);
+  return out.str();
+}
+void checkProfile(CDCalMode &mode, CDAceData &ace, CDFixedSource &fixed, CDGeometry &geometry,
+                  CDTally &tally, CDSampling &sampling, CDPerturbation &perturb) {
+#if defined(USE_MPI) || defined(USE_OMP) || defined(AIS) || defined(USE_PYTHON_API) || !defined(__linux__)
+  throw std::invalid_argument("prepared: requires Linux serial standard MGACE build without AIS/Python");
+#endif
+  requirePrepared(mode.p_nRmcCalcMode == CDCalMode::FixedSourceMode && mode.p_nParticleMode == CDCalMode::NeutronMode,
+                  "only neutron fixed-source mode is supported");
+  requirePrepared(!mode.p_bSkipCalculation && !mode.p_bDagmc && !geometry.p_bDagmc && !geometry.p_bPBS &&
+                  geometry.p_vCLSUniverse.empty(), "unsupported geometry/calculation option");
+  requirePrepared(ace.p_bIsMultiGroup && ace.p_bIsMultiGroupNeu && !ace.p_bTMS && !ace.p_bUseOtfDb,
+                  "only standard MGACE without TMS/OTFDB is supported");
+  requirePrepared(!sampling.p_bIsSampling && !sampling.p_bIsBurn && !perturb.p_bDiffrOprt && !perturb.p_bDiffrOprtForTMP,
+                  "sampling/perturbation unsupported");
+  requirePrepared(!Output.p_bRestart && !Output.p_bIsWriteSurfSrc && Output.p_dStopTime <= 0. &&
+                  Output.p_llOutRestartInterval == 0 && fixed.LBMethod == CDFixedSource::NONE &&
+                  !fixed.p_bFissMult && fixed.p_vFissMult.empty(), "restart/time/fission-multiplicity unsupported");
+  requirePrepared(!OParticleTracker.p_bPtracOpen, "PTRAC unsupported");
+  requirePrepared(!OWeightWindow.p_bUseMCNPweightwindow && !OWeightWindow.p_bWeightWindowGeneratorOn &&
+                  (mode.p_nVarRedMode[1] == CDCalMode::CellImportance || mode.p_nVarRedMode[1] == CDCalMode::TrackMeshWeightWindow),
+                  "only native track-mesh WW or analog supported");
+  requirePrepared(!tally.p_bCap && !tally.p_bIsWithSurfTally && !tally.p_bIsWithPointTally &&
+                  !tally.p_bIsWithCsTally && !tally.p_bIsWithFETTally && !tally.p_bIsWithDFTally && !tally.p_bIsWithMaterialTally && !tally.p_bIsWithXSCalculation,
+                  "only cell and Cartesian mesh tally supported");
+  auto base = [](const BaseTally &t) {
+    requirePrepared(t.tallyType->type == 1 && t.p_nTallyParticle == 1 &&
+        t.estimator == BaseTally::TallyEstimator::TRACKLENGTH && t.p_dAbsoluteValue == 0., "only neutron TL flux tally supported");
+  };
+  for (const auto &t : tally.p_vCellTally) {
+    base(t); requirePrepared(t.p_vCAPNucZaid.empty() && t.p_vTimeBins.empty() && t.p_vDose.empty() &&
+                            t.p_vGaussian.empty(), "special cell tally unsupported");
+    // Existing ScoreCellTally SCHECK+energy-bin normalization can access missing volume data.
+    // Keep that legacy path unchanged and reject it in this restricted entry.
+    requirePrepared(!(tally.p_bUseStatisticsCheck && t.p_bUseStatisticalCheck && !t.p_vErgBins.empty()),
+                    "energy-binned cell SCHECK unsupported; use a separate total-flux diagnostic tally");
+  }
+  for (const auto &t : tally.p_vMeshTally) {
+    base(t); requirePrepared(t.p_OTallyMesh.p_nGeoType == CDMesh::CUBOID && t.p_OTallyMesh.p_bUseVol && t.p_vDose.empty(),
+                            "Cartesian mesh Normalize=1 without dose required");
+  }
+}
+void checkBanks(CDFixedSource &fixed) {
+  for (size_t i = 0; i < fixed.p_vFixedParticleSrcBank.size(); ++i)
+    requirePrepared(fixed.p_vFixedParticleSrcBank[i].size() <= (i == 1 ? 1U : 0U), "live descendant bank remains");
+  requirePrepared(fixed.p_nFixedSrcCount == fixed.p_llCurTotParNum && fixed.p_nPhotonBankCount == 0 && fixed.p_nElectronBankCount == 0,
+                  "live legacy bank remains");
+}
+}
+
+void CDCalMode::CheckOrdinaryFixedSourceAllowed() const {
+  requirePrepared(preparedProcessOwner == nullptr, "ordinary fixed-source cannot reuse a prepared process");
+}
+
+void CDCalMode::InitializePreparedFixedSourceRuns(const FixedSourceSeriesSpec &series, CDNeutronTransport &neutron, CDPhotonTransport &photon,
+      CDElectronTransport &electron, CDAceData &ace, CDFixedSource &fixed,
+      CDMaterial &material, CDGeometry &geometry, CDParticleState &particle, CDTally &tally, CDBurnup &burnup, CDRNG &rng, CDCriticality &criticality,
+      CDSampling &sampling, CDPerturbation &perturb) {
+  requirePrepared(this == &OCalMode && preparedPhase == PreparedPhase::Uninitialized && !preparedProcessOwner,
+                  "prepared process/model already initialized or wrong CalMode owner");
+  checkProfile(*this, ace, fixed, geometry, tally, sampling, perturb);
+  requirePrepared(!burnup.p_bIsWithBurnup && tally.p_pTallyDataPointer.empty(), "requires a fresh uninitialized model");
+  requirePrepared(rng.GetRNGType() == CDRNG::rngLCG63_0, "Type2 RNG required");
+  CDRNG::ValidatePreparedType2Substream(series.rootSeed, series.firstHistoryOffset, 1, series.stride);
+  requirePrepared(neutron.p_dWgtCutOff == 0.25 && neutron.p_dStartWgt == 1., "special weight policy unsupported");
+  for (const auto &t : tally.p_vMeshTally)
+    requirePrepared(t.p_vErgBins == std::vector<double>{-1.}, "mesh ENERGY=-1 required");
+  for (const auto &surface : geometry.p_vSurface)
+    requirePrepared(!surface.p_bMove, "moving geometry unsupported");
+  preparedEnergyCutoff = neutron.p_dEg0CutOff;
+  preparedWeightCutoff = neutron.p_dWgtCutOff;
+  preparedHasWW = OWeightWindow.p_bUseMeshWeightWindow;
+  preparedProcessOwner = this;
+  preparedPhase = PreparedPhase::Preparing;
+  try {
+    // Initialize forward exactly once; the first requested role is installed by Prepare.
+    fixed.p_bIsAdjoint = false;
+    ace.p_bIsAdjoint = false;
+    InitializeFixedSourceModel(*this, neutron, photon, electron, ace, fixed, material, geometry,
+                               particle, tally, burnup, rng, sampling, perturb);
+    requirePrepared(!ace.HasNonzeroPreparedFissionProduction(material), "nonzero/nonfinite nuSigmaF unsupported");
+    preparedOwners = {&neutron, &photon, &electron, &ace, &fixed, &material, &geometry, &particle,
+                      &tally, &rng, &criticality, &sampling, &perturb, &burnup};
+    preparedRegistry = tally.p_pTallyDataPointer;
+    for (auto *d : preparedRegistry)
+      requirePrepared(d == &tally.p_OCellTallyData || d == &tally.p_OMeshTallyData, "invalid tally registry owner");
+    preparedDefinition = definition(ace, material, geometry, tally);
+    preparedOutput = Output.p_fpOutputFilePtr;
+    preparedOutputHandles = outputHandles();
+    preparedTreatFission = neutron.p_bTreatFission;
+    requirePrepared(validPreparedFile(preparedOutput), "invalid output handle");
+    preparedSeries = series; preparedNextOffset = series.firstHistoryOffset;
+    OTimer.reg(Utility::FixedSource); OTimer.reg(Utility::Tally);
+    preparedPhase = PreparedPhase::ModelReady;
+  } catch (...) { preparedPhase = PreparedPhase::Failed; throw; }
+}
+
+void CDCalMode::PrepareFixedSourceRun(const FixedSourceRunSpec &spec, const CDExternalSource &source,
+    CDExternalSource &activeSource, CDNeutronTransport &neutron, CDAceData &ace,
+    CDFixedSource &fixed, CDMaterial &material, CDGeometry &geometry,
+    CDParticleState &particle, CDTally &tally, CDRNG &rng) {
+  // All rejecting input checks occur in Run before the first CLEAR below.
+  fixed.ResetRunState(); neutron.ResetPreparedRunCounters(preparedWeightCutoff);
+  tally.ResetRunScores(spec.sourceHistories); ace.ClearPreparedDerivedData();
+  particle.ResetForFixedSourceRun(); OWeightWindow.ClearPreparedNativeState();
+  OTimer[Utility::FixedSource].ResetForPreparedRun(); OTimer[Utility::Tally].ResetForPreparedRun();
+  fixed.SetPreparedRun(spec.sourceHistories, spec.role, spec.maxAdjointEnergyMeV);
+  fixed.InitiateTrspt(neutron);
+  activeSource.ResetWorkingSourceFrom(source);
+  ace.PrepareFixedSourceMode(spec.role, p_nParticleMode);
+  fixed.RebuildPreparedRunCutoffs(ace);
+  OWeightWindow.InstallPreparedNativeState(spec.weightWindow, spec.role, geometry, *this, neutron, preparedWeightCutoff);
+  particle.RebuildForFixedSourceRun(geometry, material, ace, spec.role, preparedEnergyCutoff, neutron.p_dWgtCutOff);
+  rng.ConfigurePreparedType2Substream(preparedSeries.rootSeed, preparedNextOffset, spec.sourceHistories, preparedSeries.stride);
+}
+
+FixedSourceRunReceipt CDCalMode::RunPreparedFixedSource(const FixedSourceRunSpec &spec,
+    const CDExternalSource &source, CDNeutronTransport &neutron, CDPhotonTransport &photon,
+      CDElectronTransport &electron, CDAceData &ace, CDFixedSource &fixed,
+      CDMaterial &material, CDGeometry &geometry, CDParticleState &particle, CDTally &tally, CDRNG &rng, CDCriticality &criticality,
+      CDSampling &sampling, CDPerturbation &perturb) {
+  requirePrepared(preparedProcessOwner == this &&
+      (preparedPhase == PreparedPhase::ModelReady || preparedPhase == PreparedPhase::Finalized), "Run in invalid lifecycle state");
+  using Clock = std::chrono::steady_clock;
+  const auto t0 = Clock::now();
+  std::vector<const void *> owners = {&neutron, &photon, &electron, &ace, &fixed, &material, &geometry, &particle,
+                                     &tally, &rng, &criticality, &sampling, &perturb, preparedOwners.back()};
+  requirePrepared(owners == preparedOwners, "wrong bound owner");
+  requirePrepared(spec.role == FixedSourceRole::Forward || spec.role == FixedSourceRole::Adjoint, "invalid role");
+  requirePrepared(!preparedHasRun || spec.runId > preparedLastRunId, "runId must increase");
+  requirePrepared(spec.sourceHistories > 0 && spec.sourceHistories <= INT_MAX / 2, "population exceeds bank capacity contract");
+  requirePrepared(std::isfinite(spec.maxAdjointEnergyMeV) && spec.maxAdjointEnergyMeV > 0., "invalid adjoint physical energy");
+  requirePrepared(!spec.sourceIdentity.empty(), "source identity required");
+  requirePrepared(rng.GetRNGType() == CDRNG::rngLCG63_0, "Type2 RNG required");
+  const auto seed = CDRNG::ValidatePreparedType2Substream(preparedSeries.rootSeed, preparedNextOffset,
+                                                        spec.sourceHistories, preparedSeries.stride);
+  checkProfile(*this, ace, fixed, geometry, tally, sampling, perturb);
+  requirePrepared(tally.p_pTallyDataPointer == preparedRegistry &&
+      definition(ace, material, geometry, tally) == preparedDefinition, "model/tally/WW definition changed");
+  requirePrepared(Output.p_fpOutputFilePtr == preparedOutput && validPreparedFile(preparedOutput) &&
+                  outputHandles() == preparedOutputHandles,
+                  "output handle changed/closed");
+  requirePrepared(!OTimer[Utility::FixedSource].running && !OTimer[Utility::Tally].running, "run timer still running");
+  requirePrepared(neutron.p_dEg0CutOff == preparedEnergyCutoff && neutron.p_bTreatFission == preparedTreatFission,
+                  "neutron physics changed");
+  source.CheckPreparedSourceDefinition(geometry);
+  const auto &energies = ace.p_vNeuMltErgBins;
+  const double energy = source.p_vSource.front().p_dEnergy;
+  requirePrepared(!energies.empty() && energy >= *std::min_element(energies.begin(), energies.end()) &&
+                  energy <= *std::max_element(energies.begin(), energies.end()), "source energy outside model groups");
+  for (auto *d : preparedRegistry)
+    if (d->p_OStatisticsTester.p_nTallyToCheck)
+      requirePrepared(spec.sourceHistories >= d->p_OStatisticsTester.p_nBatch &&
+                      spec.sourceHistories % d->p_OStatisticsTester.p_nBatch == 0, "statistics requires complete batches");
+  const auto &ww = spec.weightWindow;
+  requirePrepared(ww.appliesToTransportRole == spec.role, "WW role mismatch");
+  if (ww.enabled) {
+    requirePrepared(preparedHasWW && OWeightWindow.p_OWeightWindowMesh.p_nGeoType == CDMesh::CUBOID, "no fixed Cartesian WW topology");
+    const auto &bins = OWeightWindow.p_vEnergyBins[1];
+    requirePrepared(bins.size() >= 2 && ww.lower.size() ==
+                    size_t(OWeightWindow.p_OWeightWindowMesh.GetTotMeshNum()) * (bins.size() - 1), "WW shape mismatch");
+    const auto &para = OWeightWindow.p_vWeightWindowPara[1];
+    requirePrepared(para.size() >= 8 && !ww.identity.empty(), "WW parameter/identity missing");
+    for (auto x : ww.lower)
+      requirePrepared(std::isfinite(x) && x > 0. && std::isfinite(x * para[CDWeightWindow::WUPN]) &&
+                      std::isfinite(x * para[CDWeightWindow::WSURVN]), "invalid WW lower/upper/survival");
+  } else requirePrepared(ww.lower.empty(), "disabled WW must have no lower values");
+  if (preparedHasRun) checkBanks(fixed);
+  CDExternalSource activeSource;
+  preparedPhase = PreparedPhase::Preparing;
+  try {
+    PrepareFixedSourceRun(spec, source, activeSource, neutron, ace, fixed, material, geometry, particle, tally, rng);
+    OTimer[Utility::FixedSource].start();
+    preparedPhase = PreparedPhase::Executing;
+    const auto t1 = Clock::now();
+    ExecuteFixedSourcePrepared(*this, neutron, photon, electron, ace, fixed, material, geometry, particle,
+                               tally, rng, criticality, activeSource, sampling, perturb);
+    const auto t2 = Clock::now();
+    preparedPhase = PreparedPhase::Finalizing;
+    fixed.VerifyPreparedSourceWeights(spec.sourceHistories);
+    requirePrepared(fixed.p_llCurTotParNum == spec.sourceHistories && fixed.p_dTotStartWgt == double(spec.sourceHistories),
+                    "completed histories/statistical denominator mismatch");
+    FinalizeFixedSourceRun(fixed, material, ace, tally);
+    requirePrepared(fixed.p_dTotStartWgt == double(spec.sourceHistories), "finalize changed denominator");
+    checkBanks(fixed);
+    auto maxDraws = rng.FinishPreparedType2Substream();
+    fixed.FinishPreparedSourceWeightAudit(spec.sourceHistories);
+    OTimer[Utility::FixedSource].stop();
+    const auto t3 = Clock::now();
+    FixedSourceRunReceipt receipt;
+    receipt.runId = spec.runId; receipt.role = spec.role;
+    receipt.requestedHistories = spec.sourceHistories; receipt.completedHistories = fixed.p_llCurTotParNum;
+    receipt.normalizationDenominator = fixed.p_dTotStartWgt;
+    receipt.sourceWeightAudit = fixed.GetPreparedSourceWeightAudit(); receipt.unitSourceWeightsVerified = true;
+    receipt.prepareSeconds = std::chrono::duration<double>(t1-t0).count();
+    receipt.transportSeconds = std::chrono::duration<double>(t2-t1).count();
+    receipt.tallyFinalizeSeconds = std::chrono::duration<double>(t3-t2).count();
+    receipt.mcSeconds = receipt.prepareSeconds + receipt.transportSeconds + receipt.tallyFinalizeSeconds;
+    receipt.measuredMcSeconds = std::chrono::duration<double>(t3-t0).count();
+    receipt.rootSeed = preparedSeries.rootSeed; receipt.effectiveSeed = seed; receipt.stride = preparedSeries.stride;
+    receipt.historyOffset = preparedNextOffset; receipt.finalSeed = rng.GetSeed(); receipt.maximumHistoryDraws = maxDraws;
+    receipt.finalPosition = rng.GetPosition(); receipt.finalPositionPre = rng.GetPositionPre();
+    receipt.batches = fixed.p_llCurrentBatch; receipt.collisions = fixed.p_llTotCollisionCount;
+    receipt.missedParticles = neutron.p_nMissParticleCount;
+    receipt.sourceIdentity = spec.sourceIdentity; receipt.weightWindowIdentity = ww.identity;
+    preparedNextOffset += spec.sourceHistories; preparedLastRunId = spec.runId; preparedHasRun = true;
+    preparedPhase = PreparedPhase::Finalized;
+    return receipt;
+  } catch (...) {
+    OTimer[Utility::FixedSource].stop(); OTimer[Utility::Tally].stop();
+    preparedPhase = PreparedPhase::Failed;
+    throw; // no receipt; failed series cannot resume or reclaim its RNG segment
+  }
+}
+void CDCalMode::FinishPreparedFixedSourceRuns() {
+  requirePrepared(preparedProcessOwner == this &&
+      (preparedPhase == PreparedPhase::ModelReady || preparedPhase == PreparedPhase::Finalized), "Finish in invalid lifecycle state");
+  preparedPhase = PreparedPhase::Closed;
+  // OutputEnding and process-global handles belong to the caller, exactly once.
+}
diff --git a/tests/prepared_fixed_source_lifecycle/CMakeLists.txt b/tests/prepared_fixed_source_lifecycle/CMakeLists.txt
new file mode 100644
index 0000000..d1a509e
--- /dev/null
+++ b/tests/prepared_fixed_source_lifecycle/CMakeLists.txt
@@ -0,0 +1,25 @@
+get_target_property(prepared_sources RMC SOURCES)
+set(original_main "${PROJECT_SOURCE_DIR}/src/main.cpp")
+set(main_count 0)
+foreach(src IN LISTS prepared_sources)
+  if(src STREQUAL original_main)
+    math(EXPR main_count "${main_count}+1")
+  endif()
+endforeach()
+if(NOT main_count EQUAL 1)
+  message(FATAL_ERROR "Prepared harness expected exactly one production main.cpp")
+endif()
+list(REMOVE_ITEM prepared_sources "${original_main}")
+add_executable(RMCPreparedLifecycle ${prepared_sources} driver.cpp globals.cpp)
+target_link_libraries(RMCPreparedLifecycle ${libraries})
+foreach(prop COMPILE_DEFINITIONS COMPILE_OPTIONS INCLUDE_DIRECTORIES)
+  get_target_property(value RMC ${prop})
+  if(value)
+    set_property(TARGET RMCPreparedLifecycle PROPERTY ${prop} "${value}")
+  endif()
+endforeach()
+set_property(TARGET RMCPreparedLifecycle APPEND_STRING PROPERTY LINK_FLAGS
+             " -Wl,-Map=${CMAKE_CURRENT_BINARY_DIR}/prepared-link.map")
+file(GENERATE OUTPUT "${CMAKE_CURRENT_BINARY_DIR}/prepared-sources.txt"
+     CONTENT "$<JOIN:$<TARGET_PROPERTY:RMCPreparedLifecycle,SOURCES>,\n>\n")
+add_test(NAME prepared_source_weight_audit COMMAND RMCPreparedLifecycle --mode source-weight-audit-selftest)
