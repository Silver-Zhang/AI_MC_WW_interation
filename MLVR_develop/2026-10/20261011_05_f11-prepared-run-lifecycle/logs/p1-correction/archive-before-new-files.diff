+// Public-API integration harness. There is no transport loop in this file.
+#include "CalMode.h"
+#include "Input.h"
+#include "Utility/Timer.h"
+#include "Utility/IO/Logger.h"
+#include "rmc/file/hdf5/HDF5.hpp"
+#include <fstream>
+#include <sstream>
+#include <iomanip>
+#include <iostream>
+#include <stdexcept>
+#include <limits>
+#include <chrono>
+#include <thread>
+#include <dirent.h>
+using RMC::IO::OLogger;
+using RMC::IO::OProcLogger;
+namespace {
+std::map<std::string,std::string> options;
+std::string option(const std::string &name, const std::string &fallback = "") {
+  auto it = options.find(name); return it == options.end() ? fallback : it->second;
+}
+void receipt(const FixedSourceRunReceipt &r, const std::string &dir) {
+  std::ofstream out(dir + "/receipt-" + std::to_string(r.runId) + ".json");
+  if (!out) throw std::runtime_error("cannot open receipt output");
+  out << std::setprecision(17) << "{\n";
+#define NUMBER(x) out << "\"" #x "\":" << r.x << ",\n"
+  NUMBER(runId); out << "\"role\":\"" << (r.role == FixedSourceRole::Forward ? "F" : "A") << "\",\n";
+  NUMBER(requestedHistories); NUMBER(completedHistories); NUMBER(normalizationDenominator);
+  NUMBER(prepareSeconds); NUMBER(transportSeconds); NUMBER(tallyFinalizeSeconds); NUMBER(mcSeconds); NUMBER(measuredMcSeconds);
+  NUMBER(rootSeed); NUMBER(effectiveSeed); NUMBER(stride); NUMBER(historyOffset); NUMBER(finalSeed);
+  NUMBER(maximumHistoryDraws); NUMBER(finalPosition); NUMBER(finalPositionPre); NUMBER(batches); NUMBER(collisions); NUMBER(missedParticles);
+#undef NUMBER
+  out << "\"sourceWeightAudit\":{\"sampledHistories\":" << r.sourceWeightAudit.sampledHistories
+      << ",\"nonUnitHistories\":" << r.sourceWeightAudit.nonUnitHistories
+      << ",\"initialWeightSum\":" << r.sourceWeightAudit.initialWeightSum
+      << ",\"minimumInitialWeight\":" << r.sourceWeightAudit.minimumInitialWeight
+      << ",\"maximumInitialWeight\":" << r.sourceWeightAudit.maximumInitialWeight << "},\n"
+      << "\"unitSourceWeightsVerified\":" << (r.unitSourceWeightsVerified ? "true" : "false") << ",\n"
+      << "\"timingScope\":\"" << r.timingScope << "\",\n"
+      << "\"statisticsTimingScope\":\"" << r.statisticsTimingScope << "\",\n"
+      << "\"statisticsFomIsRunMetric\":" << (r.statisticsFomIsRunMetric ? "true" : "false") << ",\n"
+      << "\"sourceIdentity\":\"" << r.sourceIdentity << "\",\n"
+      << "\"weightWindowIdentity\":\"" << r.weightWindowIdentity << "\"\n}\n";
+}
+void auditSelftest() {
+  int passed = 0;
+  for (double weight : {2., 0., -1., std::numeric_limits<double>::quiet_NaN(), std::numeric_limits<double>::infinity()}) {
+    CDFixedSource f; f.ResetRunState(); f.SetPreparedRun(1, FixedSourceRole::Forward, 30.);
+    bool rejected = false;
+    try { f.CheckAndRecordPreparedSourceWeight(weight); } catch (const std::exception &e) { rejected = true; std::cout << e.what() << '\n'; }
+    if (!rejected || f.GetPreparedSourceWeightAudit().nonUnitHistories != 1) throw std::runtime_error("weight audit failed to reject");
+    ++passed;
+  }
+  CDFixedSource f; f.ResetRunState(); f.SetPreparedRun(2, FixedSourceRole::Forward, 30.);
+  f.CheckAndRecordPreparedSourceWeight(1.);
+  bool rejected = false; try { f.VerifyPreparedSourceWeights(2); } catch (const std::exception &) { rejected = true; }
+  if (!rejected) throw std::runtime_error("short count accepted");
+  f.CheckAndRecordPreparedSourceWeight(1.); f.VerifyPreparedSourceWeights(2);
+  std::cout << "SOURCE_WEIGHT_AUDIT " << passed + 2 << "/7 passed\n";
+}
+void resources(std::ostream &out, unsigned long long id, CDTally &tally, CDAceData &ace, CDFixedSource &fixed) {
+  if (!OTimer[Utility::Total].running || OTimer[Utility::FixedSource].running || OTimer[Utility::Tally].running ||
+      fixed.IsPreparedSourceWeightGuardEnabled()) throw std::runtime_error("invalid completed run timer/audit state");
+  long rss = 0; std::ifstream stat("/proc/self/status"); std::string line;
+  while (std::getline(stat, line)) if (line.compare(0,6,"VmRSS:") == 0) rss = std::stol(line.substr(6));
+  int fd = 0; DIR *d = opendir("/proc/self/fd"); while (readdir(d)) ++fd; closedir(d);
+  out << id << '\t' << rss << '\t' << fd << '\t' << tally.p_pTallyDataPointer.size() << '\t' << ace.p_vNuclides.data();
+  for (auto *p : tally.p_pTallyDataPointer) out << '\t' << p << ':' << p->p_vSum1.size() << ':' << p->p_vSum1.capacity();
+  for (auto &bank : fixed.p_vFixedParticleSrcBank) out << '\t' << bank.size() << ':' << bank.ParticleBank.capacity();
+  out << '\n'; out.flush();
+}
+std::string runState(CDTally &tally, CDFixedSource &fixed, CDRNG &rng) {
+  std::ostringstream out; out << std::hexfloat;
+  out << fixed.p_llCurTotParNum << '/' << fixed.p_llCurrentBatch << '/' << fixed.p_dTotStartWgt
+      << '/' << rng.GetSeed() << '/' << rng.GetPosition() << '/' << rng.GetPositionPre();
+  for (auto *data : tally.p_pTallyDataPointer)
+    for (const auto *v : {&data->p_vScore, &data->p_vScoreTemp, &data->p_vSum1, &data->p_vSum2,
+                         &data->p_vSum3, &data->p_vAve, &data->p_vRe}) {
+      out << '/' << v->size(); for (double x : *v) out << ':' << x;
+    }
+  return out.str();
+}
+}
+int main(int argc, char **argv) {
+  try {
+    for (int i = 1; i < argc; i += 2) { if (i+1 == argc) throw std::invalid_argument("option without value"); options[argv[i]] = argv[i+1]; }
+    if (option("--mode") == "source-weight-audit-selftest") { auditSelftest(); return 0; }
+    CDRNG runRng; CDInput input; CDGeometry geometry; CDMaterial material; CDAceData ace;
+    CDCriticality criticality; CDBurnup burnup; CDTally tally; CDConvergence convergence;
+    CDParticleState particle; CDPlot plot; CDFixedSource fixed; CDExternalSource source;
+    CDNeutronTransport neutron; CDPhotonTransport photon; CDElectronTransport electron;
+    CDAdjoint adjoint; CDSampling sampling; CDKinetics kinetics; CDPerturbation perturb;
+    Depth_Class depth; TTA_Class tta; ME_Class me; CDHomogenization homogenization;
+    std::vector<std::string> args = {"RMCPreparedLifecycle", "-i", option("--input"), "-d", option("--data")};
+    std::vector<char *> ptr; for (auto &a : args) ptr.push_back(&a[0]);
+    input.CheckIOFile(ptr.size(), ptr.data());
+    OLogger.init_logger(Output.p_chOutputFileName);
+    OLogger.SetDefaultLogLevel(RMC::IO::LogLevel::info); OLogger.SetDefaultTarget(RMC::IO::LogTarget::ConsoleAndLogFile);
+    OProcLogger = OLogger; OProcLogger.SetAllowEveryProcLogging(true);
+    Output.OutputHeading(criticality);
+    input.ReadInputBlocks(OCalMode, neutron, photon, electron, geometry, material, ace, criticality, tally,
+        convergence, burnup, plot, fixed, runRng, adjoint, homogenization, source, sampling, kinetics, perturb);
+    if (option("--mode") == "fresh") {
+      if (!option("--histories").empty()) {
+        fixed.p_llUserInputParNum = std::stoll(option("--histories"));
+        fixed.CheckFixedSource();
+      }
+      auto seed = std::stoull(option("--effective-seed", "17"));
+      runRng.SetSeed0(seed); runRng.SetSeed(seed); runRng.SetStride(std::stoull(option("--stride", "100000")));
+      runRng.SetPosition(0); runRng.SetPositionPre(-1000);
+      OCalMode.RunCalculation(OCalMode, neutron, photon, electron, ace, geometry, depth, criticality, material,
+          particle, convergence, tally, burnup, fixed, runRng, me, tta, adjoint, source, sampling, kinetics, perturb);
+    } else if (option("--mode") == "persistent") {
+      FixedSourceSeriesSpec series;
+      series.rootSeed = std::stoull(option("--root-seed", "17")); series.stride = std::stoull(option("--stride", "100000"));
+      series.firstHistoryOffset = std::stoull(option("--offset", "0"));
+      auto initialize = [&]() { OCalMode.InitializePreparedFixedSourceRuns(series, neutron, photon, electron, ace,
+          fixed, material, geometry, particle, tally, burnup, runRng, criticality, sampling, perturb); };
+      if (option("--negative") != "uninitialized") initialize();
+      std::ifstream plan(option("--plan")); if (!plan) throw std::runtime_error("plan unreadable");
+      std::ofstream resourceLog(option("--snapshot-dir") + "/resources.tsv");
+      std::string line; size_t index = 0;
+      while (std::getline(plan,line)) {
+        if (line.empty() || line[0] == '#') continue;
+        FixedSourceRunSpec spec; char role; double x, direction; int window;
+        std::istringstream row(line); if (!(row >> spec.runId >> role >> spec.sourceHistories >> x >> direction >> window)) throw std::runtime_error("bad plan row");
+        spec.role = role == 'F' ? FixedSourceRole::Forward : FixedSourceRole::Adjoint;
+        CDExternalSource canonical;
+        if (option("--preserve-source") == "yes" && (option("--negative-after") != "yes" || index > 0)) {
+          canonical = source;
+        } else {
+          CDSource point;
+          point.p_nSourceID = 1; point.p_vPoints = {x,0.,0.}; point.p_vReferVector = {direction,0.,0.};
+          point.p_dEnergy = 2.; point.p_dDirecMiu = 1.;
+          for (auto v : {CDSource::FRACTION,CDSource::PARTICLE,CDSource::POINT,CDSource::VECTOR,CDSource::DIRECMIU,CDSource::ENERGY,CDSource::WEIGHT})
+            point.p_vVariableDefined[v] = true;
+          canonical.AddSource(point);
+          canonical.CheckSourceAndDistri(geometry);
+        }
+        spec.sourceIdentity = "point-" + std::to_string(x) + "-dir-" + std::to_string(direction);
+        spec.weightWindow.appliesToTransportRole = spec.role;
+        spec.weightWindow.enabled = window != 0;
+        spec.weightWindow.identity = "ww-" + std::to_string(window);
+        if (window) spec.weightWindow.lower = window == 1 ? std::vector<double>{.1,1.,.1,1.} : std::vector<double>{.05,.5,.05,.5};
+        const bool trigger = option("--negative-after") != "yes" || index > 0;
+        std::string negative = trigger ? option("--negative") : "";
+        if (negative == "double-initialize") initialize();
+        if (negative == "after-finish") OCalMode.FinishPreparedFixedSourceRuns();
+        if (negative == "reinitialize-after-finish") { OCalMode.FinishPreparedFixedSourceRuns(); initialize(); }
+        if (negative == "role") spec.role = static_cast<FixedSourceRole>(999);
+        if (negative == "zero-N") spec.sourceHistories = 0;
+        if (negative == "negative-N") spec.sourceHistories = -1;
+        if (negative == "ww-role") spec.weightWindow.appliesToTransportRole = FixedSourceRole::Adjoint;
+        if (negative == "ww-shape") { spec.weightWindow.enabled = true; spec.weightWindow.lower = {.1}; }
+        if (negative == "ww-negative" || negative == "ww-nan") { spec.weightWindow.enabled = true; spec.weightWindow.lower = {.1,1.,.1,1.}; spec.weightWindow.lower[0] = negative == "ww-negative" ? -1. : std::numeric_limits<double>::quiet_NaN(); }
+        if (negative == "weight-binding") canonical.p_vSource[0].p_mDistriIndexU[CDSource::WEIGHT] = 1;
+        if (negative == "empty-source") canonical.p_vSource.clear();
+        if (negative == "weight2") canonical.p_vSource[0].p_dWeight = 2.;
+        if (negative == "neutron-type") canonical.p_vSource[0].p_nParticleType = 2;
+        if (negative == "run-id" && index) spec.runId = 1;
+        const std::string before = runState(tally, fixed, runRng);
+        auto callRun = [&]() { return OCalMode.RunPreparedFixedSource(spec, canonical, neutron, photon, electron,
+            ace, fixed, material, geometry, particle, tally, runRng, criticality, sampling, perturb); };
+        FixedSourceRunReceipt r;
+        try {
+          if (negative == "wrong-owner") { CDTally wrong; OCalMode.RunPreparedFixedSource(spec, canonical, neutron, photon, electron, ace, fixed, material, geometry, particle, wrong, runRng, criticality, sampling, perturb); }
+          r = callRun();
+        } catch (const std::exception &e) {
+          std::cout << "REJECTED_RUN state_unchanged=" << (before == runState(tally, fixed, runRng))
+                    << " completed=" << fixed.p_llCurTotParNum << " reason=" << e.what() << '\n';
+          if (option("--check-failed") == "yes") {
+            bool retryRejected = false, finishRejected = false;
+            try { callRun(); } catch (const std::exception &again) {
+              retryRejected = std::string(again.what()).find("invalid lifecycle state") != std::string::npos;
+            }
+            try { OCalMode.FinishPreparedFixedSourceRuns(); } catch (const std::exception &) { finishRejected = true; }
+            std::cout << "FAILED_TERMINAL retry_rejected=" << retryRejected << " finish_rejected=" << finishRejected << '\n';
+            if (!retryRejected || !finishRejected) throw std::runtime_error("failed lifecycle was reusable");
+          }
+          throw;
+        }
+        receipt(r, option("--snapshot-dir"));
+        if (option("--legacy-output") == "yes") {
+          // Test-owned per-run export: legacy HDF tables/conditional datasets are
+          // not overwrite-complete. Keep the bound handle, replace only its prior
+          // Tally output group. This does not reset any transport or tally state.
+          if (index > 0) Output.p_Result->DeleteData("Tally");
+          tally.OutputTally(tally.Final, material);
+          tally.OutputTallyh5(tally.Final, 0, 0, 0);
+        }
+        resources(resourceLog,r.runId,tally,ace,fixed);
+        std::cout << "PREPARED_RUN_SUCCESS " << r.runId << '\n';
+        ++index;
+        if (option("--gap") == "yes") {
+          auto gapStart = std::chrono::steady_clock::now();
+          double totalBefore = OTimer[Utility::Total].record();
+          std::this_thread::sleep_for(std::chrono::milliseconds(100));
+          std::cout << std::setprecision(17) << "INTER_RUN_GAP " << r.runId << ' '
+                    << std::chrono::duration<double>(std::chrono::steady_clock::now()-gapStart).count()
+                    << ' ' << totalBefore << ' ' << OTimer[Utility::Total].record() << '\n';
+        }
+      }
+      OCalMode.FinishPreparedFixedSourceRuns();
+    } else throw std::invalid_argument("unknown driver mode");
+    Output.OutputEnding(OCalMode, adjoint, criticality, fixed);
+    return 0;
+  } catch (const std::exception &e) { std::cerr << "PREPARED_FAILURE " << e.what() << '\n'; return 2; }
+}
