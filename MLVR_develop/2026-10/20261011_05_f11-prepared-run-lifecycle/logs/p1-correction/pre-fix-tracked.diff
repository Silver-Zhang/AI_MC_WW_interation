+unsigned long long CDRNG::ValidatePreparedType2Substream(unsigned long long root,
+    unsigned long long offset, long long histories, unsigned long long stride) {
+  const unsigned long long period = 1ULL << 61, mask = (1ULL << 63) - 1;
+  if (!root || root > mask || !(root & 1) || !stride || histories <= 0 ||
+      stride > period || offset > period / stride ||
+      static_cast<unsigned long long>(histories) > period / stride - offset)
+    throw std::invalid_argument("prepared: invalid Type2 seed/stride/history segment or period exceeded");
+  unsigned long long exponent = offset * stride, multiplier = 3512401965023503517ULL, power = 1;
+  while (exponent) {
+    if (exponent & 1) power = (power * multiplier) & mask;
+    multiplier = (multiplier * multiplier) & mask;
+    exponent >>= 1;
+  }
+  return (root * power) & mask;
+}
+void CDRNG::ConfigurePreparedType2Substream(unsigned long long root, unsigned long long offset,
+                                         long long histories, unsigned long long stride) {
+  if (type != rngLCG63_0 || generator->preparedGuard)
+    throw std::logic_error("prepared: requires idle Type2 RNG");
+  const auto seed = ValidatePreparedType2Substream(root, offset, histories, stride);
+  SetSeed0(seed); SetSeed(seed); SetStride(stride); SetPosition(0); SetPositionPre(-1000);
+  generator->preparedHistories = histories;
+  generator->preparedStarted = generator->preparedDraws = generator->preparedMaxDraws = 0;
+  generator->preparedGuard = true;
+}
+unsigned long long CDRNG::FinishPreparedType2Substream() {
+  if (!generator->preparedGuard || generator->preparedStarted != generator->preparedHistories ||
+      GetPosition() != static_cast<long long>(generator->preparedHistories))
+    throw std::runtime_error("prepared: RNG history count mismatch");
+  generator->preparedGuard = false;
+  return generator->preparedMaxDraws;
+}
