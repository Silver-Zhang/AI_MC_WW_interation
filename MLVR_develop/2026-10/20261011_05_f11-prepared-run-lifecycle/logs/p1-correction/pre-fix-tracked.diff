+}
+void CDFixedSource::SetPreparedRun(long long histories, FixedSourceRole role, double maxAdjointEnergyMeV) {
+  if (histories <= 0 || histories > INT_MAX / 2 ||
+      (role != FixedSourceRole::Forward && role != FixedSourceRole::Adjoint) ||
+      !std::isfinite(maxAdjointEnergyMeV) || maxAdjointEnergyMeV <= 0.)
+    throw std::invalid_argument("prepared: invalid population/role/adjoint energy");
+  p_llUserInputParNum = histories;
+  p_llParIntervalEachPro = histories;
+  CheckFixedSource();
+  p_bIsAdjoint = role == FixedSourceRole::Adjoint;
+  p_dMaxAdjointNeutronEnergy = p_bIsAdjoint ? maxAdjointEnergyMeV : 20.;
+  p_dMaxAdjointPhotonEnergy = 20.;
+  preparedWeightGuard = true;
+}
+void CDFixedSource::RebuildPreparedRunCutoffs(CDAceData &ace) {
+  if (p_bIsAdjoint)
+    p_dMaxAdjointNeutronEnergy = ace.LocateMgErgGrp(p_dMaxAdjointNeutronEnergy, CDParticleState::Neutron);
+}
+void CDFixedSource::CheckAndRecordPreparedSourceWeight(double weight) {
+  if (!preparedWeightGuard) throw std::logic_error("prepared: source audit is not armed");
+  auto &a = preparedWeightAudit;
+  ++a.sampledHistories;
+  a.initialWeightSum += weight;
+  if (a.sampledHistories == 1) a.minimumInitialWeight = a.maximumInitialWeight = weight;
+  else { a.minimumInitialWeight = std::min(a.minimumInitialWeight, weight);
+         a.maximumInitialWeight = std::max(a.maximumInitialWeight, weight); }
+  if (!std::isfinite(weight) || weight != 1.) {
+    ++a.nonUnitHistories;
+    throw std::runtime_error("prepared: non-unit initial source weight at history " +
+                             std::to_string(a.sampledHistories) + ": " + std::to_string(weight));
+  }
+}
+void CDFixedSource::VerifyPreparedSourceWeights(long long histories) const {
+  const auto &a = preparedWeightAudit;
+  if (!preparedWeightGuard || a.sampledHistories != histories || a.nonUnitHistories != 0 ||
+      a.initialWeightSum != double(histories) || a.minimumInitialWeight != 1. || a.maximumInitialWeight != 1.)
+    throw std::runtime_error("prepared: initial source weight audit failed");
+}
+void CDNeutronTransport::ResetPreparedRunCounters(double defaultWeightCutoff) {
+  p_nMissParticleCount = p_nMissNeutronCount = 0;
+  p_dWgtCutOff = defaultWeightCutoff;
+}
+
+void CDFixedSource::FinishPreparedSourceWeightAudit(long long histories) {
+  VerifyPreparedSourceWeights(histories);
+  preparedWeightGuard = false;
+}
