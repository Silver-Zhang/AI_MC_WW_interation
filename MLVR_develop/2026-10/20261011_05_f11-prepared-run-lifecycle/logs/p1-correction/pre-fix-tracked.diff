+void CDExternalSource::CheckPreparedSourceDefinition(CDGeometry &geometry) const {
+  (void)geometry;
+  auto require = [](bool ok) { if (!ok) throw std::invalid_argument("prepared: unsupported source definition"); };
+  require(p_nSourceType == OrdinarySource && p_vSource.size() == 1 && p_vSurfSrc.empty());
+  require(p_vDitributions.size() == 1 && p_vTransforms.size() == 1 && p_vFissMult.empty());
+  require(p_vFraction == std::vector<double>{1.} && p_vBiasFrac == std::vector<double>{1.});
+  require(p_nFixedInitSrcBankCount == 0 && p_nFixedInitPhoSrcBankCount == 0 &&
+          p_vFixedInitSrcBank.empty() && p_vFixedInitPhoSrcBank.empty());
+  const auto &s = p_vSource.front();
+  require(s.p_eSourceType == CDSource::Point && !s.isCellSource && !s.p_bIsWithCellCut && !s.p_bIsRotated);
+  require(s.p_nParticleType == 1 && s.p_dWeight == 1. && s.p_dFraction == 1. &&
+          (s.p_dBiasFrac == 0. || s.p_dBiasFrac == 1.));
+  require(s.p_nCell == 0 && s.p_nTransformIndexU == -1 && s.p_dTime == 0. && s.p_nNorm == 1 && s.p_dSpontaFissNu == 0.);
+  require(s.p_mDistriIndexU.empty() && s.p_vVarisNamesWithDistri.empty() && s.p_vVarisIndexWithDistri.empty());
+  for (auto i : s.p_vDistriIndex) require(i == 0);
+  for (const auto &layer : s.p_vLayerVarIndexDistri) require(layer.empty());
+  for (size_t i = 0; i < s.p_vVariableDefined.size(); ++i)
+    if (s.p_vVariableDefined[i]) require(i == CDSource::FRACTION || i == CDSource::BIASFRAC ||
+        i == CDSource::PARTICLE || i == CDSource::POINT || i == CDSource::VECTOR ||
+        i == CDSource::DIRECMIU || i == CDSource::ENERGY || i == CDSource::WEIGHT);
+  require(s.p_vVariableDefined[CDSource::POINT] && s.p_vVariableDefined[CDSource::VECTOR] &&
+          s.p_vVariableDefined[CDSource::ENERGY]);
+  require(s.p_vPoints.size() == 3 && s.p_vReferVector.size() == 3 && s.p_dDirecMiu == 1. &&
+          std::isfinite(s.p_dEnergy) && s.p_dEnergy > 0.);
+  double norm = 0.;
+  for (double x : s.p_vPoints) require(std::isfinite(x));
+  for (double x : s.p_vReferVector) { require(std::isfinite(x)); norm += x*x; }
+  require(std::isfinite(norm) && norm > 0.);
+}
