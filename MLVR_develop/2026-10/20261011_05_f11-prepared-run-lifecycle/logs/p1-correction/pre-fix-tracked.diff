+  ProcessWeightWindow(geometry, CDParticleState::Neutron, p_vEnergyBins[CDParticleState::Neutron], lower,
+                      para[WUPN], para[WSURVN]);
+  p_bUseMeshWeightWindow = true;
+  mode.p_nVarRedMode[CDParticleState::Neutron] = CDCalMode::TrackMeshWeightWindow;
+  mode.p_nChangeNeuCutWgt = 2;
+  neutron.p_dWgtCutOff = 1.e-8;
+}
