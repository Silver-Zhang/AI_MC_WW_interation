+void CDAceData::PrepareFixedSourceMode(FixedSourceRole role, int particleMode) {
+  ClearPreparedDerivedData();
+  if (role != FixedSourceRole::Forward && role != FixedSourceRole::Adjoint)
+    throw std::invalid_argument("prepared: invalid ACE role");
+  p_bIsAdjoint = role == FixedSourceRole::Adjoint;
+  if (p_bIsAdjoint) treatAdjointMaterial(particleMode);
+}
+bool CDAceData::HasNonzeroPreparedFissionProduction(CDMaterial &material) {
+  // All loaded physical nuclides: conservative superset of used materials.
+  // A nonfinite value is unsupported, never silently treated as zero production.
+  (void)material;
+  for (size_t i = 1; i < p_vNuclides.size(); ++i) {
+    int nu = GetMgNeuLNU(i), fis = GetMgNeuLFIS(i);
+    if (!nu) continue;
+    if (!fis) return true;
+    for (int g = 0; g < p_nNeuMltGrpNum; ++g) {
+      double n = p_vNuclides[i].XSS.at(nu + g), f = p_vNuclides[i].XSS.at(fis + g);
+      if (!std::isfinite(n) || !std::isfinite(f) || n * f != 0.) return true;
+    }
+  }
+  return false;
+}
