+void mutateTestWWDefinition(const std::string &kind) {
+  auto &w = OWeightWindow;
+  const double nan = std::numeric_limits<double>::quiet_NaN(), inf = std::numeric_limits<double>::infinity();
+  if (kind == "outer-empty") w.p_vEnergyBins.clear();
+  else if (kind == "outer-one") w.p_vEnergyBins.resize(1);
+  else if (kind == "inner-empty") w.p_vEnergyBins.at(1).clear();
+  else if (kind == "inner-one") w.p_vEnergyBins.at(1) = {0.};
+  else if (kind == "duplicate") w.p_vEnergyBins.at(1) = {0., 1., 1., INFINITY_ENERGY};
+  else if (kind == "descending") w.p_vEnergyBins.at(1) = {0., 2., 1., INFINITY_ENERGY};
+  else if (kind == "nan-interior") w.p_vEnergyBins.at(1) = {0., nan, INFINITY_ENERGY};
+  else if (kind == "nan-terminal") w.p_vEnergyBins.at(1).back() = nan;
+  else if (kind == "inf-interior") w.p_vEnergyBins.at(1) = {0., inf, INFINITY_ENERGY};
+  else if (kind == "inf-terminal") w.p_vEnergyBins.at(1).back() = inf;
+  else if (kind == "negative-inf") w.p_vEnergyBins.at(1).front() = -inf;
+  else if (kind == "missing-sentinel") w.p_vEnergyBins.at(1).back() = 30.;
+  else if (kind == "negative-first") w.p_vEnergyBins.at(1).front() = -1.;
+  else if (kind == "energy-dimension") w.p_vEnergyBins.at(1) = {0., 1., INFINITY_ENERGY};
+  else if (kind == "mesh-outer-empty") w.p_vMeshInformation.clear();
+  else if (kind == "mesh-outer-one") w.p_vMeshInformation.resize(1);
+  else if (kind == "mesh-outer-two") w.p_vMeshInformation.resize(2);
+  else if (kind == "other-particle") w.p_vMeshInformation.at(2) = w.p_vMeshInformation.at(1);
+  else if (kind == "mesh-inner-empty") w.p_vMeshInformation.at(1).clear();
+  else if (kind == "mesh-ragged") w.p_vMeshInformation.at(1).at(0).clear();
+  else if (kind == "parameters-outer-empty") w.p_vWeightWindowPara.clear();
+  else if (kind == "parameters-outer-one") w.p_vWeightWindowPara.resize(1);
+  else if (kind == "parameters-inner-empty") w.p_vWeightWindowPara.at(1).clear();
+  else if (kind == "parameters-inner-short") w.p_vWeightWindowPara.at(1).resize(2);
+  else if (kind == "non-cartesian") w.p_OWeightWindowMesh.p_nGeoType = CDMesh::CYLINDER;
+  else if (kind == "count-overflow") {
+    w.p_vEnergyBins.at(1) = {0., 1., INFINITY_ENERGY};
+    w.p_OWeightWindowMesh.p_nTotMeshNum = std::numeric_limits<int>::max();
+  } else throw std::runtime_error("unknown WW definition mutation");
+  std::cout << std::setprecision(17) << "WW_DEFINITION_MUTATION " << kind << " bins=";
+  for (const auto &v : w.p_vEnergyBins) { std::cout << '['; for (double x : v) std::cout << x << ','; std::cout << ']'; }
+  std::cout << " mesh=";
+  for (const auto &v : w.p_vMeshInformation) { std::cout << '['; for (const auto &m : v) std::cout << m.size() << ','; std::cout << ']'; }
+  std::cout << " parameters=";
+  for (const auto &v : w.p_vWeightWindowPara) { std::cout << '['; for (double x : v) std::cout << x << ','; std::cout << ']'; }
+  std::cout << " topology=" << w.p_OWeightWindowMesh.p_nGeoType << " meshes=" << w.p_OWeightWindowMesh.p_nTotMeshNum << '\n';
+}
+void wwLookupSelftest() {
+  auto &w = OWeightWindow;
+  w.p_vEnergyBins.at(1) = {0., .5, 2., INFINITY_ENERGY};
+  w.p_OWeightWindowMesh.p_nTotMeshNum = 1;
+  w.p_vMeshInformation.at(1).resize(1);
+  w.p_vMeshInformation.at(1).at(0).resize(3);
+  for (int i = 0; i < 3; ++i) {
+    auto &b = w.p_vMeshInformation.at(1).at(0).at(i);
+    b.p_dLowerWeightBound = 11. * (i+1);
+    b.p_dSurvivalWeight = 33. * (i+1);
+    b.p_dUpperWeightBound = 55. * (i+1);
+  }
+  if (w.ValidatePreparedNativeDefinition() != 3) throw std::runtime_error("bad lookup fixture");
+  CDRNG &untouched = ORNG;
+  const auto seed = untouched.GetSeed();
+  const auto position = untouched.GetPosition();
+  const auto pre = untouched.GetPositionPre();
+  int passed = 0;
+  for (auto test : std::vector<std::pair<double,int>>{{-1.,0}, {0.,0}, {.25,0},
+       {std::nextafter(.5,0.),0}, {.5,1}, {1.,1}, {std::nextafter(2.,0.),1}, {2.,2}, {3.,2},
+       {std::nextafter(INFINITY_ENERGY,0.),2}, {INFINITY_ENERGY,2},
+       {std::nextafter(INFINITY_ENERGY,std::numeric_limits<double>::infinity()),2}}) {
+    double lower = -1., survival = -1., upper = -1.;
+    w.setMeshWeightWindowBound(lower,survival,upper,CDParticleState::Neutron,0,test.first);
+    if (lower != 11.*(test.second+1) || survival != 33.*(test.second+1) || upper != 55.*(test.second+1))
+      throw std::runtime_error("production WW endpoint lookup returned wrong bounds");
+    std::cout << std::setprecision(17) << "WW_LOOKUP energy=" << test.first << " bin=" << test.second
+              << " lower=" << lower << " survival=" << survival << " upper=" << upper << '\n';
+    ++passed;
+  }
+  for (double energy : {std::numeric_limits<double>::quiet_NaN(), std::numeric_limits<double>::infinity(), -std::numeric_limits<double>::infinity()}) {
+    double lower = -1., survival = -1., upper = -1.; bool rejected = false;
+    try { w.setMeshWeightWindowBound(lower,survival,upper,CDParticleState::Neutron,0,energy); }
+    catch (const std::invalid_argument &e) {
+      rejected = std::string(e.what()) == "WW lookup: nonfinite particle energy";
+      std::cout << "WW_LOOKUP_REJECT energy=" << energy << " reason=" << e.what() << '\n';
+    }
+    if (!rejected || lower != -1. || survival != -1. || upper != -1.) throw std::runtime_error("invalid WW lookup accepted/mutated result");
+    ++passed;
+  }
+  if (seed != untouched.GetSeed() || position != untouched.GetPosition() || pre != untouched.GetPositionPre())
+    throw std::runtime_error("lookup changed RNG");
+  std::cout << "WW_LOOKUP_SELFTEST " << passed << "/15 passed; owner-level (no MC transport)\n";
 }
