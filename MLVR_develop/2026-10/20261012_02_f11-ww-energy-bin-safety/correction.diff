+size_t CDWeightWindow::ValidatePreparedNativeDefinition() const {
+  auto require = [](bool ok, const char *message) {
+    if (!ok) throw std::invalid_argument(std::string("prepared: ") + message);
+  };
+  const size_t neutron = CDParticleState::Neutron;
+  require(!p_bUseMCNPweightwindow && !p_bWeightWindowGeneratorOn &&
+          p_OWeightWindowMesh.p_nGeoType == CDMesh::CUBOID && p_OWeightWindowMesh.p_nTotMeshNum > 0,
+          "no fixed Cartesian WW topology");
+  require(p_vEnergyBins.size() > neutron, "WW energy-bin neutron outer entry missing");
+  const auto &bins = p_vEnergyBins[neutron];
+  require(bins.size() >= 2 && bins.size() <= size_t(INT_MAX), "WW energy-bin boundary count invalid");
+  for (size_t i = 0; i < bins.size(); ++i) {
+    require(std::isfinite(bins[i]), "WW energy-bin boundary must be finite");
+    if (i) require(bins[i] > bins[i-1], "WW energy-bin boundaries must strictly increase");
+  }
+  // Native parser starts at zero and appends this finite (1e22 MeV) sentinel.
+  require(bins.front() == 0. && bins.back() == INFINITY_ENERGY,
+          "WW energy-bin endpoints must be 0 and INFINITY_ENERGY");
+  require(p_vWeightWindowPara.size() > neutron && p_vWeightWindowPara[neutron].size() >= 8,
+          "WW parameters missing");
+  const auto &para = p_vWeightWindowPara[neutron];
+  const double upper = para[WUPN], survival = para[WSURVN], split = para[MXSPLN];
+  require(std::isfinite(upper) && upper > 2., "WW WUPN must be finite and > 2");
+  require(std::isfinite(survival) && survival > 1. && survival < upper,
+          "WW WSURVN must be finite and 1 < WSURVN < WUPN");
+  require(std::isfinite(split) && split > 1. && split <= INT_MAX && std::floor(split) == split,
+          "WW MXSPLN must be a finite integer in [2, INT_MAX]");
+  const size_t meshCount = size_t(p_OWeightWindowMesh.p_nTotMeshNum), intervals = bins.size() - 1;
+  // ProcessWeightWindow uses int for its flat mesh*energy count.
+  require(meshCount <= size_t(INT_MAX) / intervals, "WW mesh/energy count exceeds int range");
+  // InitiateWeightWindow visits neutron through electron, even in neutron mode.
+  require(p_vMeshInformation.size() > size_t(CDParticleState::Electron) &&
+          p_vMeshInformation[neutron].size() == meshCount,
+          "WW installed neutron mesh shape mismatch");
+  for (size_t particle = 0; particle < p_vMeshInformation.size(); ++particle)
+    require(particle == neutron || p_vMeshInformation[particle].empty(),
+            "WW prepared topology must contain neutron windows only");
+  for (const auto &mesh : p_vMeshInformation[neutron])
+    require(mesh.size() == intervals, "WW installed energy-bin shape mismatch");
+  return meshCount * intervals;
+}
