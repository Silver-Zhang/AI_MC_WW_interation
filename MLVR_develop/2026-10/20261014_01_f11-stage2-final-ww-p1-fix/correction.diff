+void CDWeightWindow::ValidatePreparedNativeLowerBounds(const vector<double> &lower, size_t expectedCount) const {
+  if (lower.size() != expectedCount)
+    throw std::invalid_argument("prepared: WW shape mismatch");
+  const auto &para = p_vWeightWindowPara[CDParticleState::Neutron];
+  double maximumWeight = 1., minimumSurvival = std::numeric_limits<double>::max();
+  for (double x : lower) {
+    const double upper = x * para[WUPN], survival = x * para[WSURVN];
+    if (!(std::isfinite(x) && x > 0. && std::isfinite(upper) && std::isfinite(survival) &&
+          x < survival && survival < upper && std::isfinite(x * para[MXSPLN])))
+      throw std::invalid_argument("prepared: invalid WW lower/upper/survival or splitting bound");
+    maximumWeight = std::max(maximumWeight, upper);
+    minimumSurvival = std::min(minimumSurvival, survival);
+  }
+  if (!(maximumWeight / minimumSurvival <= double(INT_MAX - 1)))
+    throw std::invalid_argument("prepared: WW unit-source/cross-window splitting ratio exceeds int range");
+}
