#ifdef RMC_F11_PROBE
class CDFixedSource;
class CDAceData;
class CDParticleState;
class CDTally;
class CDRNG;
class CDExternalSource;
namespace f11_probe {
// Observers: no RNG calls, no mutation of simulation state; record in memory.
void mark(const char *);
void begin(const char *);
void end(const char *);
void flush();
class Scope {
public:
  explicit Scope(const char *);
  ~Scope();
private:
  const char *name;
};
void snapshot(const char *, const CDFixedSource &, const CDAceData &,
              const CDParticleState &, const CDTally &, const CDRNG &,
              const CDExternalSource &);
void history(const CDFixedSource &, const CDRNG &);
void particle_context(const CDParticleState &);
void ww_lookup(int particle_type, int mesh_index, double physical_energy,
               int actual_ww_energy_bin, double lower, double survival, double upper);
#ifdef RMC_F11_REUSE_EXPERIMENT
// This is a control seam. Default unarmed -> false.
// Only an approved task driver may arm it after explicit per-run preparation.
bool consume_prepared_state_token();
#endif
}
#endif
